#!/usr/bin/env xdg-open
[Desktop Entry]
Categories=Graphics;Viewer;
Comment[en_US]=image viewer, folder image viewer, archive pic viewer
Comment=image viewer, folder image viewer, archive pic viewer
Exec=$HOME/.local/bin/roneyview
GenericName[en_US]=Image viewer
GenericName=Penampil Gambar
Icon=roneyview
